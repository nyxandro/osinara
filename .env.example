# Required production secrets and Telegram identity.
POSTGRES_PASSWORD=
DATABASE_URL=
INVITATION_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
GROQ_API_KEY=
# Key of the active model provider.
MODEL_API_KEY=

# Optional integrations; paired credentials must be supplied together when enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# API keys skills use in sandboxes: 32 random bytes in base64 (`openssl rand -base64 32`). Without it
# the owner cannot store a key and the sandbox gateway refuses every key request.
SANDBOX_API_KEY_ENCRYPTION_KEY=
# Outbound voice messages; without it send_voice_message reports that voice is not configured.
ELEVENLABS_API_KEY=
# GIF replies through KLIPY; without it, or without an image-capable model, send_gif is not offered.
KLIPY_API_KEY=
