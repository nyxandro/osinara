# Доступ экспортёра к базе Osinara production. Реальный файл кладётся в
# /opt/monitoring-agent/osinara-metrics.env с правами 0600 и в git не попадает.
#
# Хост postgres разрешается внутри сети osinara-production-app-network, к которой
# экспортёр подключается сетью osinara из compose.override.yaml.
# Учётной записи достаточно права SELECT на вьюхи monitoring_*.
OSINARA_METRICS_DSN=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@postgres:5432/osinara?sslmode=disable
