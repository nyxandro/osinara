{
  "name": "osinara-family-agent",
  "version": "0.40.3",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "esbuild agent/main.ts scripts/create-bootstrap-code.ts scripts/memory-review-admin.ts scripts/reindex-memory.ts scripts/repair-ai-digest.ts scripts/migrate.ts scripts/memory-embedding-worker.ts scripts/telegram-ingress-worker.ts scripts/validate-model-provider-config.ts services/sandbox-runner/main.ts services/sandbox-egress-proxy/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outbase=. --outdir=.runtime",
    "bootstrap:code": "node --experimental-strip-types scripts/create-bootstrap-code.ts",
    "dev": "tsx watch --env-file-if-exists=.env agent/main.ts",
    "install:gws": "node --experimental-strip-types scripts/install-google-workspace-cli.ts",
    "setup:google": "node --experimental-strip-types scripts/configure-google-workspace-cli.ts",
    "start": "node .runtime/agent/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "migrate:runtime": "node .runtime/scripts/migrate.js",
    "memory:reindex": "node --import tsx scripts/reindex-memory.ts",
    "memory:usage-report": "node --import tsx scripts/memory-quality/usage-report.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.37",
    "@ai-sdk/groq": "4.0.27",
    "@ai-sdk/openai-compatible": "3.0.29",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/provider-utils": "5.0.26",
    "@googleworkspace/cli": "0.22.5",
    "ai": "7.0.60",
    "async-sema": "3.1.1",
    "dockerode": "5.0.1",
    "file-type": "22.0.1",
    "pg": "8.22.0",
    "tar-stream": "3.2.0",
    "tsx": "4.23.0",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.20.0",
    "@types/tar-stream": "3.1.4",
    "esbuild": "0.28.1",
    "fast-check": "4.10.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "ai": "7.0.60"
  }
}
